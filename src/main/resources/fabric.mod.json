{
  "schemaVersion": 1,
  "id": "realradio",
  "version": "${version}",
  "name": "realradio",
  "description": "",
  "authors": [],
  "contact": {},
  "license": "MIT",
  "icon": "assets/realradio/icon.png",
  "environment": "*",
